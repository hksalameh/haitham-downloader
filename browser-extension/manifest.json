{
  "manifest_version": 3,
  "name": "Haitham Downloader Classic 4.1",
  "version": "0.4.2",
  "description": "Classic 4.1.3: التقاط الروابط المباشرة قبل نافذة Chrome، واختيار الحفظ والاتصالات المتعددة. الملفات الأخرى تبقى في Chrome.",
  "permissions": [
    "downloads",
    "contextMenus",
    "notifications",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:18767/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "مدير تحميل هيثم",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}